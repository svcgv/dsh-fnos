{
  "name": "dsh-fnos",
  "version": "0.2.9",
  "private": true,
  "description": "DeepSeek Harness for fnOS: native gateway app with per-project isolation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/test.mjs --verify",
    "icons": "node scripts/make-icons.mjs",
    "package:fpk": "node scripts/package.mjs",
    "package:amd64": "node scripts/package.mjs --arch amd64",
    "package:arm64": "node scripts/package.mjs --arch arm64",
    "harness:payload": "node scripts/build-harness-payload.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:fpk": "node scripts/verify-fpk.mjs",
    "release": "node scripts/release.mjs",
    "release:amd64": "node scripts/release.mjs --arch amd64",
    "release:arm64": "node scripts/release.mjs --arch arm64",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
