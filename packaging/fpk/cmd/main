#!/bin/bash
# Start, stop and report the dsh-fnos supervisor.
set -u

APP="${TRIM_APPDEST:?}"
VAR="${TRIM_PKGVAR:?}"
LOG="${VAR}/dsh-fnos.log"
PID_FILE="${VAR}/dsh-fnos.pid"
NODE_APP="${DSH_FNOS_NODE_APP:-/var/apps/nodejs_v26/target/bin/node}"
NODE_APP_BIN="${NODE_APP%/*}"
RUNTIME_LIB="${APP}/runtime/lib"
RUNTIME_BIN="${APP}/runtime/bin"
NODE=""

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >>"${LOG}"
}

fail() {
    log_msg "ERROR: $*"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$*" >>"${TRIM_TEMP_LOGFILE}"
    fi
    exit 1
}

node_major() {
    "$1" -p 'process.versions.node.split(".")[0]' 2>/dev/null
}

node_status() {
    local output
    output="$("$1" -p 'process.versions.node' 2>&1)"
    if [ "$?" -eq 0 ]; then
        printf 'Node.js %s' "${output}"
    else
        printf '%s' "${output:-无法执行}"
    fi
}

supports_node() {
    local major
    major="$(node_major "$1")"
    [ -n "${major}" ] && [ "${major}" -eq 26 ]
}

pick_node() {
    local candidate
    for candidate in \
        "${NODE_APP}" \
        "${DSH_FNOS_NODE:-}" \
        "$(command -v node 2>/dev/null || true)"
    do
        if [ -n "${candidate}" ] && [ -x "${candidate}" ] && supports_node "${candidate}"; then
            printf '%s' "${candidate}"
            return 0
        fi
    done
    return 1
}

prepare_runtime() {
    export PATH="${RUNTIME_BIN}:${NODE_APP_BIN}:${PATH:-}"
    [ -r "${RUNTIME_LIB}/libatomic.so.1" ] || fail "应用文件不完整：缺少或无法读取 ${RUNTIME_LIB}/libatomic.so.1，请重新安装完整 FPK"
    # Always put the bundled library first, even if it already appears later.
    export LD_LIBRARY_PATH="${RUNTIME_LIB}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
}

read_pid() {
    if [ -r "${PID_FILE}" ]; then
        tr -d '[:space:]' <"${PID_FILE}"
    fi
}

is_running() {
    local pid
    pid="$(read_pid)"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

start() {
    if is_running; then
        return 0
    fi

    prepare_runtime
    NODE="$(pick_node)" || fail "nodejs_v26 插件运行时不可用或不是 Node.js 26；诊断：$(node_status "${NODE_APP}")"
    [ -f "${APP}/server/index.js" ] || fail "应用文件不完整：缺少 server/index.js"
    [ -f "${APP}/harness/entry.js" ] || log_msg "WARN: 缺少 harness/entry.js，打开工作区时会启动失败"

    mkdir -p "${VAR}"
    log_msg "starting with ${NODE}"
    cd "${APP}" || fail "无法进入应用目录"
    nohup "${NODE}" "${APP}/server/index.js" >>"${LOG}" 2>&1 &
    printf '%s' "$!" >"${PID_FILE}"

    local waited=0
    while [ "${waited}" -lt 30 ]; do
        if is_running && [ -S "${APP}/app.sock" ]; then
            log_msg "started pid=$(read_pid)"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    fail "服务启动超时，请查看 ${LOG}"
}

stop() {
    if ! is_running; then
        rm -f "${PID_FILE}"
        return 0
    fi

    local pid
    pid="$(read_pid)"
    log_msg "stopping pid=${pid}"
    kill -TERM "${pid}" 2>/dev/null

    local waited=0
    while kill -0 "${pid}" 2>/dev/null && [ "${waited}" -lt 20 ]; do
        sleep 1
        waited=$((waited + 1))
    done

    if kill -0 "${pid}" 2>/dev/null; then
        log_msg "killing pid=${pid}"
        kill -KILL "${pid}" 2>/dev/null
    fi

    rm -f "${PID_FILE}" "${APP}/app.sock"
    return 0
}

case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    status)
        if is_running; then
            exit 0
        fi
        exit 3
        ;;
    *)
        printf 'Unknown command: %s\n' "${1:-}" >&2
        exit 1
        ;;
esac
