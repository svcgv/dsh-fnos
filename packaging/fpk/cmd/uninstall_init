#!/bin/bash
### Runs before uninstall. User data is preserved unless explicitly selected for deletion.
set -u

APP_NAME="${TRIM_APPNAME:-dsh-fnos}"

remove_app_path() {
    local path="$1"
    case "${path}" in
        */@appconf/"${APP_NAME}"|*/@apphome/"${APP_NAME}"|*/@appdata/"${APP_NAME}") ;;
        *)
            echo "拒绝删除非应用数据路径：${path}" >>"${TRIM_TEMP_LOGFILE:-/dev/null}"
            return 1
            ;;
    esac
    if [ -L "${path}" ]; then
        echo "拒绝删除符号链接路径：${path}" >>"${TRIM_TEMP_LOGFILE:-/dev/null}"
        return 1
    fi
    if [ -e "${path}" ]; then
        rm -rf "${path}"
    fi
}

"${TRIM_APPDEST}/cmd/main" stop

uninstall_mode="$(printf '%s' "${wizard_uninstall_mode:-preserve}" | tr '[:upper:]' '[:lower:]')"
case "${uninstall_mode}" in
    delete|true|1|yes|on)
        for path in "${TRIM_PKGHOME:-}" "${TRIM_PKGETC:-}" "${TRIM_PKGVAR:-}"; do
            [ -n "${path}" ] || continue
            remove_app_path "${path}" || exit 1
        done
        echo "卸载时已删除应用数据、配置和日志" >>"${TRIM_TEMP_LOGFILE:-/dev/null}"
        ;;
    *)
        echo "卸载时保留应用数据；如需清理请重新卸载并开启删除数据选项" >>"${TRIM_TEMP_LOGFILE:-/dev/null}"
        ;;
esac
exit 0
